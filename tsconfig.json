{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "paths": {
      "@contract/*": [
        "./docs/contract/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "docs/contract/**/*.ts",
    "*.config.ts"
  ]
}
